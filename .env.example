NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional callback override. Use the deployed origin in Vercel if configured.
NEXT_PUBLIC_SUPABASE_REDIRECT_URL=

# Server-only API keys. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
UNSPLASH_ACCESS_KEY=
GOOGLE_APPS_SCRIPT_URL=
# A Google Forms API key alone cannot create forms; this must be an authorized Apps Script web app URL.
